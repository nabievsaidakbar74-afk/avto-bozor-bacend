NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL connection. Create the database before migrating.
# Example: CREATE DATABASE avto_bozor;
# Tests derive a local avto_bozor_test database from this URL and do not use avto_bozor.
# Production uses prisma migrate deploy. Do not use prisma db push.
DATABASE_URL=postgresql://avto_bozor:CHANGE_ME@127.0.0.1:5432/avto_bozor?schema=public

# At least 32 characters. Generate a unique value for each environment.
# Never commit real secrets. Keep them in the host environment or a secret store.
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated browser origins for the public site and admin app.
# A wildcard is rejected. Production must list the real https origins.
CORS_ORIGIN=http://localhost:5173

# Refresh cookie. These are not separate environment variables.
# Name: refreshToken
# Path: /api/v1/auth
# HttpOnly: always
# Development: SameSite=Lax, Secure omitted
# Production: SameSite=None, Secure
# Max age follows JWT_REFRESH_EXPIRES_IN. The browser stores the refresh token in this HttpOnly cookie.
# The database stores only a hash of that token. The access token is a Bearer header and is not a cookie.

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Set TRUST_PROXY=true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
LOG_LEVEL=info

# Local file root for car images in development. The process must be able to write this directory.
# Production should replace the local driver with private object storage. Do not commit uploaded files.
STORAGE_LOCAL_ROOT=storage
